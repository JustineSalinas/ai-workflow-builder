# OpenAI (or any OpenAI-compatible provider)
OPENAI_API_KEY=

# Inngest local dev: tells the SDK to run against the local Dev Server
# instead of expecting cloud signing keys. Leave =1 for local dev.
INNGEST_DEV=1
# Leave blank for local dev; only needed when deploying to Inngest Cloud.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
